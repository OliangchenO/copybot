# 未被服务加载的环境变量示例；复制为 deploy/copybot.env 后填写，真实密钥不要提交到版本库。
# 实盘下单签名私钥；不要放进 TOML。
PRIVATE_KEY=

# 看板监听端口。
DASHBOARD_PORT=8807
# 交易引擎状态接口端口。
BOT_PORT=8807
# 服务所在的项目目录。
BOT_DIR=/opt/copybot
# Guardian 读取的交易引擎 TOML 配置路径。
BOT_CONFIG=/opt/copybot/deploy/copybot2.toml
# 观察脚本访问本机引擎状态接口的地址。
COPYBOT_API=http://127.0.0.1:8807
# 备用 Polygon 订阅源的 wss:// 地址。
POLYGON_BACKUP_WSS=
# 恢复漏单时查询链上交易的 HTTPS RPC 地址。
POLYGON_RECOVERY_RPC=
# 看板使用的本地 HTML 页面路径。
POOL_PAGE=/opt/copybot/deploy/dashboard/pool.html

# 本账户的资金钱包地址，供观察脚本使用。
OUR_WALLET=
# Fillwatch 核对成交时使用的资金钱包地址。
FILLWATCH_FUNDER=
# 旧版 watcher 观察的目标钱包地址，应与实盘 lane 一致。
WATCH_WALLET=
# 观察和告警显示的机器人名称；不决定 dry/live 模式。
BOT_NAME=copybot
# 观察脚本使用的 systemd 服务名称。
BOT_SERVICE=copybot-hot.service
# 观察脚本检查的交易引擎进程名称。
BOT_PROCESS=copybot-hot
# Fillwatch 查询链上数据使用的 RPC 地址。
FILLWATCH_RPC=

# Guardian 是否自动执行停买保护；0 只观察，1 执行。
GUARDIAN_ENFORCE=0

# 可选的邮件告警服务密钥。
RESEND_API_KEY=
# 告警收件地址。
ALERT_EMAIL_TO=
# 告警发件地址。
ALERT_EMAIL_FROM=
# 告警时间显示使用的时区。
ALERT_TZ=UTC

# 是否开启合并仓位核对功能。
MERGE_RECONCILE=0
# 是否允许实际执行仓位合并。
COPYBOT_MERGE_ENABLE=0
# 是否开启无归属仓位清理功能。
ORPHAN_SWEEP=0
